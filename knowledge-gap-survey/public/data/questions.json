            {"v": "no", "l": "No", "i": "🆕"},
            {"v": "termonly", "l": "I've heard the term but don't understand it", "i": "🤨"}
          ],
          "explainer": {
            "when": {"in": ["no", "termonly"]},
            "title": "Digital assets in 2 sentences",
            "body": "A digital asset is anything of value that exists in digital form and can be owned or transferred, such as cryptocurrency, stablecoins or a token that represents a share of a property. Many run on a blockchain: a shared record of who owns what that is very hard to alter."
          }
        },
        {
          "id": "Q18", "type": "single", "required": true,
          "showIf": {"q": "Q17", "notIn": ["no"]},
          "prompt": "How would you describe your understanding of digital assets?",
