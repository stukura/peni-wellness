        {
          "id": "K1", "type": "quiz", "required": true, "answer": "true",
          "prompt": "A blockchain is a shared record of transactions that is very hard to alter once written.",
          "explain": "True. Copies of the record sit on many computers, so changing past entries would mean overriding most of the network.",
          "flag": "REVIEW FOR ACCURACY"
        },
        {
          "id": "K2", "type": "quiz", "required": true, "answer": "true",
          "prompt": "Stablecoins are designed to keep a steady value, usually tied to a currency like the US dollar.",
          "explain": "True. Most are backed by reserves such as cash or government bonds. \"Designed to\" matters, though: some have lost their peg.",
