          "prompt": "Which of these have you heard of?",
          "help": "Pick all that apply. Hover or tap ⓘ for a quick definition.",
          "options": [
            {"v": "crypto", "l": "Cryptocurrency", "tip": "Digital money secured by cryptography, such as Bitcoin, not issued by a central bank."},
            {"v": "blockchain", "l": "Blockchain", "tip": "A shared digital record of transactions, copied across many computers, that is very hard to alter."},
            {"v": "nft", "l": "NFTs", "tip": "Non-fungible tokens: unique digital certificates of ownership for a specific item, like art or a ticket."},
            {"v": "stablecoin", "l": "Stablecoins", "tip": "Digital tokens designed to hold a steady value, usually pegged to a currency like the US dollar."},
