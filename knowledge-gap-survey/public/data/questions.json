        },
        {
          "id": "K6", "type": "quiz", "required": true, "answer": "true",
          "prompt": "Tokenization means representing ownership of an asset, such as property, as a digital token.",
          "explain": "True. Tokenization can make assets easier to divide, transfer and track, for example letting many people own a share of one building.",
          "flag": "REVIEW FOR ACCURACY"
        }
