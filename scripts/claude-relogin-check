#!/usr/bin/env python3
"""Warn when the Claude Code CLI refresh token is close to expiring.

The refresh window is anchored to the last interactive `claude /login` and does
not slide forward when the access token is refreshed, so the only reliable
signal is refreshTokenExpiresAt in the credentials file itself.

Exit codes: 0 = checked (warned or not), 1 = credentials unreadable.
"""

import json
import os
import subprocess
import sys
from datetime import datetime

CREDS = os.path.expanduser("~/.claude/.credentials.json")
WARN_WITHIN_DAYS = 3


def notify(urgency, title, body):
    subprocess.run(
        ["/usr/bin/notify-send", "-u", urgency, "-i", "dialog-warning", title, body],
        check=False,
    )


def main():
    try:
        with open(CREDS) as fh:
            oauth = json.load(fh)["claudeAiOauth"]
        expires_ms = int(oauth["refreshTokenExpiresAt"])
    except FileNotFoundError:
        notify(
            "critical",
            "Claude Code: not logged in",
            f"{CREDS} is missing. Run: claude /login",
        )
        return 1
    except (KeyError, ValueError, json.JSONDecodeError) as exc:
        notify(
            "critical",
            "Claude Code: credentials unreadable",
            f"Could not read refresh token expiry ({exc}). Run: claude /login",
        )
        return 1

    expires = datetime.fromtimestamp(expires_ms / 1000)
    days_left = (expires - datetime.now()).total_seconds() / 86400
    when = expires.strftime("%a %b %d %H:%M %Z").strip()

    if days_left <= 0:
        notify(
            "critical",
            "Claude Code login expired",
            f"Refresh token expired {when}. Run: claude /login",
        )
    elif days_left <= WARN_WITHIN_DAYS:
        notify(
            "critical",
            "Claude Code re-login soon",
            f"Refresh token expires {when} ({days_left:.1f} days). Run: claude /login",
        )

    print(f"expires {expires.isoformat()} ({days_left:.2f} days left)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
